# MMBT Fact-Checking - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# HuggingFace
# ==========================================
HF_TOKEN=your_huggingface_token_here

# ==========================================
# GPU Configuration
# ==========================================
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all

# ==========================================
# Twitter API (for MuMiN dataset)
# ==========================================
# Get your Bearer Token from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ==========================================
# Jupyter (for development)
# ==========================================
JUPYTER_TOKEN=your_jupyter_token

# ==========================================
# Experiment Configuration
# ==========================================
# Default dataset to use
DATASET=Snopes

# Noise level for white noise experiments
NOISE_LEVEL=0.1

# MuMiN dataset size
MUMIN_SIZE=small

# ==========================================
# Paths (optional, defaults are usually fine)
# ==========================================
# DATA_PATH=datasets
# OUTPUT_PATH=outputs
# LOG_PATH=logs

# ==========================================
# Training Configuration (override defaults)
# ==========================================
# BATCH_SIZE=8
# MAX_EPOCHS=100
# LEARNING_RATE=1e-5
